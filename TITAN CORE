package ui

import (
	"bufio"
	"fmt"
	"os"
	"os/exec"
	"runtime"

	"github.com/fatih/color"
)

func Clear() {
	var command *exec.Cmd

	if runtime.GOOS == "windows" {
		command = exec.Command("cmd", "/c", "cls")
	} else {
		command = exec.Command("clear")
	}

	command.Stdout = os.Stdout
	_ = command.Run()
}

func Banner() {
