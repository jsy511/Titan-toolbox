cat > cmd/titan/main.go <<'EOF'
package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"

	"titan/internal/core"
	"titan/internal/ui"
)

func main() {
	reader := bufio.NewReader(os.Stdin)

	core.Startup()

	for {
		ui.Clear()
		ui.Banner()
		ui.Status()

		fmt.Println()
		fmt.Println("  ┌─────────────────────────────────────────────┐")
		fmt.Println("  │                 TITAN CORE                  │")
		fmt.Println("  ├─────────────────────────────────────────────┤")
		fmt.Println("  │  [1] Dashboard       [6] Tools              │")
		fmt.Println("  │  [2] Terminal        [7] Lab                │")
		fmt.Println("  │  [3] Network         [8] CTF                │")
		fmt.Println("  │  [4] DNS             [9] Reports            │")
		fmt.Println("  │  [5] System          [0] Exit               │")
		fmt.Println("  └─────────────────────────────────────────────┘")
		fmt.Println()

		fmt.Print("  TITAN > ")

		input, _ := reader.ReadString('\n')
		choice := strings.TrimSpace(input)

		switch choice {
		case "1":
			ui.Dashboard()
		case "2":
			ui.Terminal()
		case "3":
			ui.Network()
		case "4":
			ui.DNS()
		case "5":
			ui.System()
		case "6":
			ui.Tools()
		case "7":
			ui.Lab()
		case "8":
			ui.CTF()
		case "9":
			ui.Reports()
		case "0":
			fmt.Println("\n  TITAN shutting down...")
			return
		default:
			fmt.Println("\n  Unknown option.")
		}

		ui.Pause(reader)
	}
}
EOF

